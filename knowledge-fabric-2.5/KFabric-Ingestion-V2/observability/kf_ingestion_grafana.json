      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "expr": "avg(rate(kbfabric_document_parse_duration_seconds_sum{job=\"kf-ingestion\"}[5m]) / rate(kbfabric_document_parse_duration_seconds_count{job=\"kf-ingestion\"}[5m])) by (file_type)", "legendFormat": "{{file_type}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "piechart",
