      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "PII Masking Duration",
      "description": "Time spent masking PII",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 31 },
