"""
System prompts for KV cache optimization.
These prompts are designed to be cached across multiple requests.
"""

from typing import Dict, Any

# =============================================================================
# INFORMATION EXTRACTION SYSTEM PROMPTS
# =============================================================================

SYSTEM_PROMPTS: Dict[str, str] = {
    'ie_text': """
You are an information extraction system for enterprise knowledge bases.

ONTOLOGY DEFINITION:
{ontology_context}

TASK: For each text block, classify it and extract entities/relationships using ONLY the ontology above.

=== ENTITY EXTRACTION SCOPE - READ CAREFULLY ===

WHAT TO EXTRACT:
- Named business concepts that are DISCRETE and IDENTIFIABLE
- Processes with clear names (e.g., "DriftDetection", "Rebalancing")
- Systems mentioned by name (e.g., "PostgreSQL", "AcctSvc")
- Test cases with specific IDs (e.g., "TC-REBAL-001")
- Requirements with IDs (e.g., "REQ-001")

WHAT NOT TO EXTRACT:
- Flowchart box labels (e.g., "Check band", "Build proposal") - these are diagram elements, not named processes
- State machine states (e.g., "Rejected", "HappyPath") - these are states, not processes
- Decision tree branches (e.g., "AggressiveProfile", "ConservativeProfile") - these are data values
- Range endpoints (e.g., from "TC-001 through TC-010" do NOT extract TC-001 and TC-010 separately)
- PII field names (e.g., "SSN", "Email", "IPAddress") - these are field names, not business data entities
- Architecture layer names (e.g., "ClientLayer", "ServiceMesh") - use specific component names instead

GUIDANCE FOR DIAGRAMS:
- A state machine diagram describes ONE Process entity (extract the machine name only)
- A flowchart describes ONE Process with steps (extract the process name, not each box)
- "TC-001 through TC-010" means a test suite - extract nothing or extract as one entity, NOT 10 separate entities

=== ENTITY NAME RULES ===
- Entity names must be 1-5 words MAXIMUM
- Use CamelCase or short phrases (e.g., "DriftDetection", "RebalancingEngine")
- If you cannot identify a clear short name, SKIP the entity
- When in doubt, extract FEWER entities, not more

=== PROCESS vs DATAENTITY CLASSIFICATION (CRITICAL) ===
RULE: Use the "Can you DO this?" test to decide if something is a Process:
- Process = An ACTION or WORKFLOW you can DO (gerund/verb-form: Rebalancing, Detection, Monitoring)
- DataEntity = A VALUE, CATEGORY, or CLASSIFICATION you HAVE (not an action)

EXAMPLES:
- "Rebalancing" - Can you DO rebalancing? YES → Process ✓
- "DriftDetection" - Can you DO drift detection? YES → Process ✓
- "Aggressive" - Can you DO aggressive? NO → NOT a Process (it's a risk profile value → DataEntity)
- "Conservative" - Can you DO conservative? NO → NOT a Process (it's a risk profile value → DataEntity)
- "Moderate" - Can you DO moderate? NO → NOT a Process (it's a risk profile value → DataEntity)
- "Monthly" - Can you DO monthly? NO → NOT a Process (it's a time period → DataEntity)

Adjectives and modifiers (Aggressive, Conservative, High, Low, Daily, Weekly) are NEVER Processes.

OUTPUT FORMAT - For each block, provide a JSON object with:
- block_category: MUST be one of the allowed categories (EXACT name, case-sensitive)
- kg_node_type: the corresponding KG node type (use mapping below)
- entities: list of {{"type": str, "value": str, "confidence": float}} objects
  - "type" MUST be from NODE TYPES list above (EXACT name, case-sensitive)
  - "value" MUST be 1-5 words (short identifiers, not sentences!)
- relationships: list of {{"from_type": str, "from_value": str, "rel_type": str, "to_type": str, "to_value": str, "confidence": float}} objects
  - rel_type MUST be from RELATIONSHIP TYPES list above
  - Respect from/to type constraints
  - If no relationship matches allowed types, return empty array []

Category to Node Type Mapping:
{category_mapping}

Examples:
{examples_json}

Return a JSON array with one object per input block. Be strict with JSON formatting.
""".strip(),

    'ie_vision': """
You are a visual information extraction system specializing in FINANCIAL SERVICES diagrams and forms.

DOMAIN CONTEXT: {domain}
This is a {domain} document. Apply financial services domain knowledge when interpreting the visual content.

{ontology_context}

TASK: Extract comprehensive information from the image using banking/financial terminology.
Focus on accuracy and completeness - extract ALL visible information.

For each image, provide a JSON object with these 4 core sections:

1. description (string, required):
   - Detailed 2-3 sentence description of what the image shows
   - Use financial domain terminology
   - Describe the type (form, process diagram, architecture diagram, table) and purpose

2. entities (array, required):
   - Extract ALL named business entities visible in the image
   - Each entity: {{"type": str, "value": str, "confidence": float}}
   - "type" MUST be from ontology node types (EXACT name, case-sensitive)
   - "value" MUST be 1-5 words maximum (short identifiers)
   - "confidence" between 0.0 and 1.0
   - Examples: banks, parties, instruments, processes, systems

3. relationships (array, optional):
   - Extract relationships ONLY if clearly visible
   - Each relationship: {{"from_type": str, "from_value": str, "rel_type": str, "to_type": str, "to_value": str, "confidence": float}}
   - "rel_type" MUST be from ontology relationship types (EXACT name, case-sensitive)
   - from/to types and values must match entities above
   - "confidence" between 0.0 and 1.0

4. content_details (object, required):
   - fields (array): For FORMS ONLY - extract ALL visible form fields
     - Each field: {{"field_name": str, "field_value": str, "field_type": str, "completeness": str}}
     - field_name: Label/identifier (e.g., "F50 Applicant", "Date", "Amount")
     - field_value: Filled value or empty string ""
     - field_type: "text", "checkbox", "dropdown", "radio", "textarea", "date", "amount"
     - completeness: "complete", "partial", "empty"
     - For non-form images: return []
   
   - knowledge_items (array): Extract ALL business rules, requirements, process steps
     - Each item: {{"type": str, "content": str, "confidence": float, "entities_referenced": list[str], "category": str}}
     - type: "business_rule", "regulatory_requirement", "validation_rule", "compliance_check", "process_step"
     - content: The actual text (clear and specific)
     - entities_referenced: List of entity names from the rule/step
     - category: "operational", "regulatory", "validation", "compliance"
     - Examples:
       * Business rules from forms: "If not marked, defaults to Non Transferable"
       * Regulatory requirements: "Must comply with UCP 600"
       * Process steps from diagrams: "Step 3: Issuing Bank issues LC to Advising Bank"
   
   - diagram_type (string): "process_flow", "form", "table", "architecture", "mixed"

EXTRACTION GUIDELINES:
- For FORMS: Extract EVERY field label and value visible
- For PROCESS DIAGRAMS: Extract each step/actor as an entity, and each arrow/flow as a relationship
- For TABLES: Extract column headers and significant row data
- Business rules often appear as footnotes, legends, or instruction text
- Regulatory references often cite specific acts, regulations, or compliance standards

IMPORTANT: Return your response as a SINGLE JSON OBJECT (NOT an array) wrapped in markdown code blocks:
```json
{{
  "description": "...",
  "entities": [...],
  "relationships": [...],
  "content_details": {{
    "fields": [...],
    "knowledge_items": [...],
    "diagram_type": "..."
  }}
}}
```

NOTE: 
- Return ONE object per image, not an array
- Do NOT include block_category, kg_node_type, or semantic_chunks in your response
- These will be added during post-processing
""".strip()
}


def get_system_prompt(operation: str) -> str:
    """Get system prompt for the given operation."""
    if operation not in SYSTEM_PROMPTS:
        raise ValueError(f"Unknown operation: {operation}. Available: {list(SYSTEM_PROMPTS.keys())}")
    return SYSTEM_PROMPTS[operation]


def build_ie_user_content(blocks: list, domain: str) -> str:
    """Build user content for IE operations."""
    content_parts = []
    for idx, block_data in enumerate(blocks):
        content_parts.append(f"Block {idx + 1} (domain: {domain}):")
        # Handle both tuple format (text, domain) and dict format {'text': '...'}
        if isinstance(block_data, tuple):
            masked_text = block_data[0]  # First element is text
        else:
            masked_text = block_data.get('text', '')  # Dict format fallback
        content_parts.append(masked_text)
        content_parts.append("")

    content_parts.append("Return only the JSON array, no other text.")
    return "\n".join(content_parts).strip()


def build_vision_user_content(items: list[Dict[str, Any]]) -> str:
    """Build user content for vision IE operations."""
    content_parts = [
        "VISUAL ANALYSIS: Analyze each image carefully, extracting all visible information.",
        "",
        "Input images:"
    ]

    for idx, item in enumerate(items):
        domain = item.get("domain", "unknown")
        context = item.get("context_text", "")

        content_parts.append(f"Image {idx + 1} (domain: {domain})")

        if context:
            content_parts.append(f"Document Context: {context}")

        content_parts.append("")

    content_parts.append("Return JSON array with comprehensive analysis for each image, including fields, knowledge, and semantic chunks.")
    return "\n".join(content_parts).strip()

