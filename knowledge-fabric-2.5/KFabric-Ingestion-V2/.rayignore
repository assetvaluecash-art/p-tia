# Ray working_dir package exclusions (in addition to runtime_env excludes)
# Reduces package size to stay under ~100MB upload limit
# Worker reads these from KBFABRIC_INGEST_PERSIST_DIR mount

.git
.venv
.venv_ray
pip_deps
drop_zone
custom_ml/**/models/
**/*.bin
**/*.safetensors
**/*.pt
**/*.pth
logs
reports
progress
uploads
nltk_data
_obsolete
**/__pycache__
**/*.pyc
*.egg-info
**/*.log
